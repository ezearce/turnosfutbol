# Copiar a .env y completar. NO commitear .env (ver .gitignore).

# --- Base de datos (Neon / PostgreSQL) ---
# URL con pooling para la app en runtime
DATABASE_URL="postgresql://usuario:password@host/basedatos?sslmode=require"
# URL directa (sin pooler) para migraciones de Prisma
DIRECT_URL="postgresql://usuario:password@host/basedatos?sslmode=require"

# --- Auth.js (NextAuth v5) ---
# Generar con: npx auth secret  (o: openssl rand -base64 32)
AUTH_SECRET=""

# --- Cloudinary (fotos de canchas) ---
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Resend (emails, opcional en V1) ---
RESEND_API_KEY=""

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

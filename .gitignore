# Ver https://help.github.com/articles/ignoring-files/ para más info.

# ─────────────── Dependencias ───────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─────────────── Next.js / build ───────────────
/.next/
/out/
/build
/.turbo
*.tsbuildinfo
next-env.d.ts

# ─────────────── Testing ───────────────
/coverage

# ─────────────── Prisma ───────────────
# Cliente generado (se regenera con `prisma generate`)
/src/generated

# ─────────────── Variables de entorno / secretos ───────────────
.env
.env.*
!.env.example
*.pem

# ─────────────── Logs ───────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ─────────────── Deploy ───────────────
.vercel

# ─────────────── Skills de herramientas (autogeneradas por Prisma) ───────────────
.agents/
.windsurf/
.claude/skills/
skills-lock.json

# ─────────────── Configuración local de Claude Code ───────────────
.claude/settings.local.json

# ─────────────── Editores / IDE ───────────────
.vscode/
.idea/
*.swp
*.swo

# ─────────────── Sistema operativo ───────────────
.DS_Store
Thumbs.db
Desktop.ini
